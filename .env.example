# ==========================================
# SMART EXPENSE CALCULATOR - ENVIRONMENT CONFIG
# ==========================================

# Application
PROJECT_NAME="Smart Expense Calculator"
VERSION=1.0.0
ENVIRONMENT=development

# Database Settings
# For PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_expense_db
# For zero-dependency local SQLite development:
# DATABASE_URL=sqlite:///./smart_expense.db

# Database Docker Defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_expense_db

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-secure-random-256-bit-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Frontend URL
VITE_API_URL=http://localhost:8000/api
